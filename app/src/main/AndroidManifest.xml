<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Blobs"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blobs">
        <activity android:name=".WelcomeActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".HomeActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EditBotActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ChatActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
